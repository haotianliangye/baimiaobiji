# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Issue #009: Cloudflare R2 云备份（4 个变量） ──────────────────────
# 配齐这 4 个后，/api/r2-presign 和 /api/r2-list 才能工作。
# 完整配法见 docs/setup/r2-cloud-backup.md。
#
# R2_ACCOUNT_ID: Cloudflare 账户 ID。
#   获取：登录 Cloudflare → 右上角头像 → "My Profile" → 页面右侧 "Account ID"
R2_ACCOUNT_ID=""

# R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY: R2 API Token 的访问密钥对。
#   创建：Cloudflare → R2 → 右侧 "Manage R2 API Tokens" → "Create API token"
#         Name: 任意（如 "baimiaobiji-backup"）
#         Permissions: "Object Read & Write"
#         Bucket: 指定到下面 R2_BUCKET 那个 bucket（最小权限原则）
#         TTL: 选 "Forever" 或自定义过期
#   创建后弹窗会显示 Secret Access Key，**只显示一次，立即复制保存**
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# R2_BUCKET: 唯一允许的 bucket，Settings 中必须填写同名 bucket。
R2_BUCKET=""

# R2 owner authentication: server only, never a VITE_ variable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
R2_OWNER_TOKEN=
R2_KEY_PREFIX=baimiaobiji
